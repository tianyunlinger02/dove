{
  "schemaVersion": "dove.behavior.case.v1",
  "id": "program-config-failure-not-research-result",
  "title": "Program or configuration failure must not be treated as a scientific negative result",
  "failureMode": "Dove has confused software/configuration failures with substantive research evidence, turning tool failures into false research conclusions.",
  "source": {
    "document": ".dove/install/DOCTOR.md",
    "lineStart": 5,
    "lineEnd": 5,
    "quotes": [
      "source CLI 还导入多个不存在的旧模块，导致 build 和 command validation 失败。用户会得到互相矛盾的命令、安装路径和产品模型。"
    ]
  },
  "fixture": "program-config-failure-not-research-result",
  "surface": {
    "host": "claude-code",
    "entry": "slash-command",
    "command": "/dove:experiment",
    "prompt": "查看最新实验失败日志，判断它对 physics-prior 研究假设意味着什么。不要联网；如果是程序或配置失败，请不要当作科研负结果。"
  },
  "budgets": {
    "timeoutMs": 150000,
    "maxBudgetUsd": 0.15
  },
  "snapshot": {
    "include": [
      ".dove/research/**",
      "paper/main.tex",
      "results/failed-run.log",
      "scripts/run_experiment.py"
    ]
  },
  "expectedBehavior": {
    "mustInspectOrChange": [
      ".dove/research/RESEARCH.md",
      "results/failed-run.log",
      "scripts/run_experiment.py"
    ],
    "mustNotTouch": [
      "paper/main.tex",
      ".dove/install/DOCTOR.md",
      ".dove/reviews/**",
      ".dove/runs/**"
    ]
  },
  "hardExpectations": [
    {
      "id": "answer-visible",
      "kind": "public-output-not-empty"
    },
    {
      "id": "classifies-config-failure",
      "kind": "public-output-includes-any",
      "terms": [
        "configuration",
        "config",
        "missing config",
        "FileNotFoundError",
        "配置",
        "程序失败"
      ]
    },
    {
      "id": "no-scientific-negative-result",
      "kind": "public-output-excludes-any",
      "terms": [
        "physics prior failed scientifically",
        "method is disproven",
        "科研负结果已经成立",
        "假设被证伪"
      ]
    },
    {
      "id": "inspect-failure-log",
      "kind": "tool-action-path",
      "verbs": [
        "Read"
      ],
      "path": "results/failed-run.log"
    },
    {
      "id": "inspect-runner-script",
      "kind": "tool-action-path",
      "verbs": [
        "Read"
      ],
      "path": "scripts/run_experiment.py"
    },
    {
      "id": "manuscript-unchanged",
      "kind": "path-unchanged",
      "path": "paper/main.tex"
    },
    {
      "id": "no-private-tool-path",
      "kind": "tool-action-forbidden-path",
      "path": ".dove/install/DOCTOR.md"
    }
  ],
  "humanReviewRubric": [
    {
      "criterion": "The run separates program/configuration failure from scientific evidence about the method.",
      "evidence": [
        "public-output.md",
        "tool-actions.json"
      ],
      "failureSignals": [
        "It says the physics prior failed because the config file was missing.",
        "It treats a launch/config error as experiment evidence."
      ]
    },
    {
      "criterion": "The useful next action addresses the setup boundary before interpreting research results.",
      "evidence": [
        "public-output.md",
        "snapshot-diff.json"
      ],
      "failureSignals": [
        "It revises scientific claims before validating the experiment setup.",
        "It ignores the missing config root cause."
      ]
    },
    {
      "criterion": "The run does not write Doctor feedback or private runner state while evaluating the log.",
      "evidence": [
        "receipt.json",
        "snapshot-after.json",
        "tool-actions.json"
      ],
      "failureSignals": [
        "DOCTOR.md appears.",
        "Evidence includes private transcript material."
      ]
    }
  ]
}

node_modules/
*.log
*.tgz
reference_repos/

# Local Dove workspace state; downstream projects may choose to track non-secret .dove/config.json policy.
.dove/*
!.dove/config.json
.dove/config.local.json

# Legacy local workspace state; Dove treats .paper/ as stale, not authoritative.
.paper/

# Claude local state
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.json

# Trellis local/generated files
.trellis/.template-hashes.json
.trellis/.version
.trellis/workspace/*
!.trellis/workspace/index.md
.trellis/tasks/
.trellis/worktree.yaml

# Local planning scratch space
.sisyphus/plans/

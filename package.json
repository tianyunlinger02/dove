{
  "name": "dove",
  "version": "0.2.0",
  "description": "Local-first Dove mission and evidence workflow pack for papers, engineering work, research, and review.",
  "type": "module",
  "bin": {
    "dove": "bin/dove-package.mjs"
  },
  "exports": {
    ".": "./dist/index.mjs"
  },
  "files": [
    ".agents/skills/dove-*/SKILL.md",
    ".codex/skills/dove-*/SKILL.md",
    ".cursor/commands/dove-*.md",
    ".opencode/commands/dove*.md",
    ".opencode/skills/dove-*/SKILL.md",
    ".opencode.json",
    "AGENTS.md",
    "dist/index.mjs",
    "bin/dove-package.mjs",
    "mcp/dove-state-server-package.mjs",
    "scripts/doctor-mcp-probe-package.mjs",
    "docs/README.md",
    "docs/INSTALL.md",
    "docs/USAGE.md",
    "docs/PACKAGING.md",
    "docs/CAPABILITY_MATRIX.md",
    "docs/DOVE_COMMAND_OUTPUT_SAMPLES.md",
    "README.md"
  ],
  "scripts": {
    "dove": "node ./bin/dove.mjs",
    "doctor": "node ./bin/dove.mjs doctor .",
    "doctor:validate": "node ./scripts/validate-doctor.mjs",
    "install:local": "node ./bin/dove.mjs install . --force",
    "mcp:serve": "node ./mcp/dove-state-server.mjs",
    "mcp:validate": "node ./scripts/validate-mcp.mjs",
    "commands:generate": "node ./scripts/generate-command-adapters-cli.mjs",
    "commands:check": "node ./scripts/generate-command-adapters-cli.mjs --check",
    "commands:validate": "node ./scripts/validate-commands.mjs",
    "workflow-goals:validate": "node ./scripts/validate-workflow-goals.mjs",
    "governance:audit": "node ./scripts/audit-governance-coverage.mjs",
    "maturity:audit": "node ./scripts/validate-maturity.mjs",
    "test": "node --test ./tests/**/*.test.mjs",
    "check": "npm run build:check && npm run commands:check && npm run commands:validate && npm run mcp:validate && npm run workflow-goals:validate && npm run governance:audit && npm test",
    "release:check": "npm run build:check && npm run commands:check && npm run maturity:audit && npm run pack:dry-run",
    "pack:dry-run": "npm pack --dry-run",
    "build": "node ./scripts/build-package.mjs",
    "build:check": "node ./scripts/build-package.mjs --check",
    "prepack": "npm run build:check"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.mjs",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tianyunlinger02/dove.git"
  },
  "keywords": [],
  "author": "",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/tianyunlinger02/dove/issues"
  },
  "homepage": "https://github.com/tianyunlinger02/dove#readme",
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}

{
  "name": "dove",
  "version": "0.2.0",
  "description": "Local-first Dove mission workflow pack for papers, engineering work, research, review, and governed autonomy.",
  "type": "module",
  "bin": {
    "dove": "./bin/dove.mjs"
  },
  "files": [
    ".agents/skills/dove-*/SKILL.md",
    ".codex/skills/dove-*/SKILL.md",
    ".cursor/commands/dove-*.md",
    ".opencode/commands/dove*.md",
    ".opencode/skills/dove-*/SKILL.md",
    ".opencode.json",
    "AGENTS.md",
    "bin",
    "docs/README.md",
    "docs/INSTALL.md",
    "docs/USAGE.md",
    "docs/PACKAGING.md",
    "docs/CAPABILITY_MATRIX.md",
    "mcp",
    "scripts",
    "src",
    "README.md"
  ],
  "scripts": {
    "dove": "node ./bin/dove.mjs",
    "doctor": "node ./bin/dove.mjs doctor .",
    "doctor:validate": "node ./scripts/validate-doctor.mjs",
    "install:local": "node ./bin/dove.mjs install . --force",
    "mcp:serve": "node ./mcp/dove-state-server.mjs",
    "serve:global-status": "node ./bin/dove.mjs serve-global-status --refresh --cloudflare --configure-cloudflare",
    "mcp:validate": "node ./scripts/validate-mcp.mjs",
    "commands:generate": "node ./scripts/generate-command-adapters.mjs",
    "commands:check": "node ./scripts/generate-command-adapters.mjs --check",
    "commands:validate": "node ./scripts/validate-commands.mjs",
    "workflow-goals:validate": "node ./scripts/validate-workflow-goals.mjs",
    "governance:audit": "node ./scripts/audit-governance-coverage.mjs",
    "maturity:audit": "node ./scripts/validate-maturity.mjs",
    "test": "node --test ./tests/**/*.test.mjs",
    "check": "npm run commands:check && npm run commands:validate && npm run mcp:validate && npm run workflow-goals:validate && npm run governance:audit && npm test",
    "release:check": "npm run commands:check && npm run maturity:audit && npm run pack:dry-run",
    "pack:dry-run": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=22"
  }
}

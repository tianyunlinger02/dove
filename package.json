{
  "name": "dove",
  "version": "3.0.7",
  "description": "Local-first Markdown research workflow for papers, experiments, figures, review, and revision.",
  "type": "module",
  "bin": {
    "dove": "bin/dove-package.mjs"
  },
  "exports": {
    ".": "./dist/index.mjs"
  },
  "files": [
    "package-resources/hosts/**",
    "dist/index.mjs",
    "bin/dove-package.mjs",
    "docs/README.md",
    "docs/INSTALL.md",
    "docs/USAGE.md",
    "docs/PACKAGING.md",
    "docs/CAPABILITY_MATRIX.md",
    "docs/DOVE_COMMAND_OUTPUT_SAMPLES.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dove": "node ./bin/dove.mjs",
    "doctor": "node ./bin/dove.mjs doctor",
    "commands:generate": "node ./scripts/generate-command-adapters-cli.mjs",
    "commands:check": "node ./scripts/generate-command-adapters-cli.mjs --check",
    "commands:validate": "node ./scripts/validate-commands.mjs",
    "installation:validate": "node ./scripts/validate-installation.mjs",
    "uninstall:validate": "node ./scripts/validate-uninstall.mjs",
    "review-runtime:validate": "node ./scripts/validate-review-runtime.mjs",
    "runs:validate": "node ./scripts/validate-runs.mjs",
    "runtime:validate": "node --test ./tests/runtime-json-transactions.test.mjs",
    "behavior:validate": "node ./evals/behavior/validate.mjs",
    "behavior:eval": "node ./evals/behavior/eval.mjs",
    "package:validate": "node ./scripts/validate-package.mjs",
    "check": "npm run build:check && npm run commands:check && npm run commands:validate && npm run uninstall:validate && npm run installation:validate && npm run review-runtime:validate && npm run runs:validate && npm run runtime:validate && npm run behavior:validate",
    "release:check": "npm run check && npm run package:validate",
    "pack:dry-run": "npm pack --dry-run",
    "build": "node ./scripts/build-package.mjs",
    "build:check": "node ./scripts/build-package.mjs --check",
    "prepack": "npm run build:check"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.mjs",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tianyunlinger02/dove.git"
  },
  "keywords": [
    "research",
    "academic-writing",
    "experiments",
    "claude-code",
    "markdown",
    "cli"
  ],
  "author": "tianyunlinger02",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/tianyunlinger02/dove/issues"
  },
  "homepage": "https://github.com/tianyunlinger02/dove#readme",
  "devDependencies": {
    "@inquirer/prompts": "^7.10.1",
    "esbuild": "^0.28.1"
  }
}

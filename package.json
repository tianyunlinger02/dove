{
  "name": "paper-factory",
  "version": "0.2.0",
  "description": "Mature academic writing workflow pack for OpenCode with commands, skills, and an optional MCP server.",
  "type": "module",
  "bin": {
    "paper-factory": "./bin/paper-factory.mjs"
  },
  "files": [
    ".opencode",
    ".opencode.json",
    ".paper",
    "bin",
    "docs",
    "mcp",
    "scripts",
    "src",
    "README.md"
  ],
  "scripts": {
    "paper-factory": "node ./bin/paper-factory.mjs",
    "doctor": "node ./bin/paper-factory.mjs doctor .",
    "install:local": "node ./bin/paper-factory.mjs install . --force",
    "mcp:serve": "node ./mcp/paper-state-server.mjs",
    "mcp:validate": "node ./scripts/validate-mcp.mjs",
    "commands:validate": "node ./scripts/validate-commands.mjs",
    "test": "node --test ./tests/**/*.test.mjs",
    "check": "npm run commands:validate && npm run mcp:validate && npm test",
    "pack:dry-run": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=22"
  }
}

{
  "name": "dove",
  "version": "3.0.0",
  "description": "Local-first Markdown research workflow for papers, experiments, figures, review, and revision.",
  "type": "module",
  "bin": {
    "dove": "bin/dove-package.mjs"
  },
  "exports": {
    ".": "./dist/index.mjs"
  },
  "files": [
    ".agents/skills/dove-*/SKILL.md",
    ".codex/skills/dove-*/SKILL.md",
    ".cursor/commands/dove-*.md",
    ".claude/commands/dove/*.md",
    ".claude/agents/dove-reviewer.md",
    ".claude/rules/dove.md",
    ".claude/skills/dove-intake/SKILL.md",
    ".claude/skills/dove-lessons-intake/SKILL.md",
    ".opencode/commands/dove*.md",
    ".opencode/skills/dove-*/SKILL.md",
    ".opencode/agents/dove-reviewer.md",
    "AGENTS.md",
    "dist/index.mjs",
    "bin/dove-package.mjs",
    "scripts/dove-user-prompt-submit-package.mjs",
    "docs/README.md",
    "docs/INSTALL.md",
    "docs/USAGE.md",
    "docs/PACKAGING.md",
    "docs/CAPABILITY_MATRIX.md",
    "docs/DOVE_COMMAND_OUTPUT_SAMPLES.md",
    "README.md"
  ],
  "scripts": {
    "dove": "node ./bin/dove.mjs",
    "doctor": "node ./bin/dove.mjs doctor",
    "commands:generate": "node ./scripts/generate-command-adapters-cli.mjs",
    "commands:check": "node ./scripts/generate-command-adapters-cli.mjs --check",
    "commands:validate": "node ./scripts/validate-commands.mjs",
    "package:validate": "node ./scripts/validate-package.mjs",
    "test": "node --test ./tests/**/*.test.mjs",
    "check": "npm run build:check && npm run commands:check && npm run commands:validate && npm test",
    "release:check": "npm run check && npm run package:validate",
    "pack:dry-run": "npm pack --dry-run",
    "build": "node ./scripts/build-package.mjs",
    "build:check": "node ./scripts/build-package.mjs --check",
    "prepack": "npm run build:check"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.mjs",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tianyunlinger02/dove.git"
  },
  "keywords": [],
  "author": "",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/tianyunlinger02/dove/issues"
  },
  "homepage": "https://github.com/tianyunlinger02/dove#readme",
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1"
  }
}
